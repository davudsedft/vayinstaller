#!/usr/bin/env bash
set -e

if [[ $EUID -ne 0 ]]; then
  echo "❌ Run as root"
  exit 1
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

WORKDIR="$(cd "$(dirname "$0")" && pwd)"
BIN_NAME="vaydns-server"
BIN_PATH="${WORKDIR}/${BIN_NAME}"
CONFIG_FILE="${WORKDIR}/vaydns.conf"

IPT_SERVICE="vaydns-iptables.service"
VAYDNS_SERVICE="vaydns.service"
SSH_SERVICE="ssh-socks.service"

# Function to display menu
show_menu() {
    clear
    echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║        ${GREEN}VAYDNS Manager${BLUE}               ║${NC}"
    echo -e "${BLUE}╠════════════════════════════════════════╣${NC}"
    echo -e "${BLUE}║                                        ║${NC}"
    echo -e "${BLUE}║  ${CYAN}1)${NC} Install VAYDNS                 ${BLUE}║${NC}"
    echo -e "${BLUE}║  ${CYAN}2)${NC} Remove VAYDNS                  ${BLUE}║${NC}"
    echo -e "${BLUE}║  ${CYAN}3)${NC} Show DNS Link                  ${BLUE}║${NC}"
    echo -e "${BLUE}║  ${CYAN}0)${NC} Exit                           ${BLUE}║${NC}"
    echo -e "${BLUE}║                                        ║${NC}"
    echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
    echo
    read -rp "Select option [0-3]: " ACTION
    echo
}

############################################
# REMOVE
############################################
remove_vaydns() {

  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo -e "${RED}❌ VAYDNS not installed${NC}"
    sleep 2
    return
  fi

  source "$CONFIG_FILE"

  echo -e "${YELLOW}[*] Stopping services...${NC}"
  systemctl stop vaydns ssh-socks vaydns-iptables 2>/dev/null || true
  systemctl disable vaydns ssh-socks vaydns-iptables 2>/dev/null || true

  echo -e "${YELLOW}[*] Removing systemd services...${NC}"
  rm -f /etc/systemd/system/${IPT_SERVICE}
  rm -f /etc/systemd/system/${VAYDNS_SERVICE}
  rm -f /etc/systemd/system/${SSH_SERVICE}
  systemctl daemon-reload

  echo -e "${YELLOW}[*] Cleaning iptables rules...${NC}"
  iptables -D INPUT -p udp --dport ${VAYDNS_PORT} -j ACCEPT 2>/dev/null || true
  iptables -t nat -D PREROUTING -p udp --dport 53 -j REDIRECT --to-ports ${VAYDNS_PORT} 2>/dev/null || true

  echo -e "${YELLOW}[*] Removing files...${NC}"
  rm -f "${WORKDIR}/server.key" "${WORKDIR}/server.pub"
  rm -f "$CONFIG_FILE"

  echo
  echo -e "${GREEN}✅ VAYDNS removed successfully${NC}"
  sleep 2
}

############################################
# GENERATE DNS LINK
############################################
generate_dns_link() {

  source "$CONFIG_FILE"

  if [[ ! -f "${WORKDIR}/server.pub" ]]; then
    echo -e "${RED}❌ Public key not found${NC}"
    return
  fi

  PUBKEY_HEX=$(tr -d '\n' < server.pub)
  FIXED_PORT=6666
  FIXED_DNS="1.1.1.1:53"
  PROTO="udp"

  DNS_RAW="${DOMAIN}&${PUBKEY_HEX}&${FIXED_PORT}&${FIXED_DNS}&${PROTO}"
  DNS_BASE64=$(echo -n "$DNS_RAW" | base64 -w0)
  DNS_LINK="dns://${DNS_BASE64}"

  echo
  echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
  echo -e "${CYAN}║        ${GREEN}Your DNS Link${CYAN}               ║${NC}"
  echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
  echo
  echo -e "${YELLOW}${DNS_LINK}${NC}"
  echo
  echo -e "${BLUE}📋 Copy this link and use it in your client${NC}"
  echo
  read -rp "Press Enter to continue..."
}

############################################
# INSTALL
############################################
install_vaydns() {

  if [[ -f "$CONFIG_FILE" ]]; then
    echo -e "${RED}❌ VAYDNS already installed${NC}"
    echo -e "${YELLOW}Use option 2 to remove first${NC}"
    sleep 2
    return
  fi

  if [[ ! -x "$BIN_PATH" ]]; then
    echo -e "${RED}❌ vaydns-server not found or not executable${NC}"
    echo -e "${YELLOW}Please download from:${NC}"
    echo -e "${BLUE}https://github.com/iamd3vil/vaydns/releases${NC}"
    sleep 3
    return
  fi

  echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
  echo -e "${CYAN}║        ${GREEN}Installation Setup${CYAN}            ║${NC}"
  echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
  echo

  read -rp "VAYDNS domain (e.g. t.example.com): " DOMAIN
  read -rp "VAYDNS UDP port (default 5300): " VAYDNS_PORT
  VAYDNS_PORT=${VAYDNS_PORT:-5300}
  read -rp "SOCKS port (default 8000): " SOCKS_PORT
  SOCKS_PORT=${SOCKS_PORT:-8000}
  
  # Get SSH port
  SSH_PORT=$(ss -tlnp | grep -E 'sshd|ssh' | grep -oE ':[0-9]+' | head -1 | cut -d: -f2)
  if [[ -z "$SSH_PORT" ]]; then
    SSH_PORT=$(grep -E "^Port " /etc/ssh/sshd_config | awk '{print $2}')
    SSH_PORT=${SSH_PORT:-22}
  fi
  
  echo -e "${YELLOW}[*] Detected SSH port: $SSH_PORT${NC}"
  echo

  cd "$WORKDIR"

  if [[ ! -f server.key ]]; then
    echo -e "${YELLOW}[*] Generating VAYDNS keys...${NC}"
    chmod +x "$BIN_PATH"
    "$BIN_PATH" -gen-key -privkey-file server.key -pubkey-file server.pub
  fi

  if [[ ! -f /root/.ssh/id_ed25519 ]]; then
    echo -e "${YELLOW}[*] Generating SSH key...${NC}"
    mkdir -p /root/.ssh
    ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519 -N ""
    cat /root/.ssh/id_ed25519.pub >> /root/.ssh/authorized_keys
  fi

  chmod 700 /root/.ssh
  chmod 600 /root/.ssh/id_ed25519
  chmod 600 /root/.ssh/authorized_keys
  chmod 644 /root/.ssh/id_ed25519.pub

  # Save config
  cat > "$CONFIG_FILE" <<EOF
DOMAIN=${DOMAIN}
VAYDNS_PORT=${VAYDNS_PORT}
SOCKS_PORT=${SOCKS_PORT}
SSH_PORT=${SSH_PORT}
EOF

  # IPTABLES SERVICE
  cat >/etc/systemd/system/${IPT_SERVICE} <<EOF
[Unit]
Description=VAYDNS IPTables Rules
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c "iptables -I INPUT -p udp --dport ${VAYDNS_PORT} -j ACCEPT; iptables -t nat -I PREROUTING -p udp --dport 53 -j REDIRECT --to-ports ${VAYDNS_PORT}"
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

  # VAYDNS SERVICE
  cat >/etc/systemd/system/${VAYDNS_SERVICE} <<EOF
[Unit]
Description=vaydns-server UDP tunnel
After=vaydns-iptables.service
Requires=vaydns-iptables.service

[Service]
User=root
WorkingDirectory=${WORKDIR}
ExecStart=${BIN_PATH} -udp :${VAYDNS_PORT} -privkey-file server.key -domain ${DOMAIN} -upstream 127.0.0.1:${SOCKS_PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

  # SSH SOCKS SERVICE
  cat >/etc/systemd/system/${SSH_SERVICE} <<EOF
[Unit]
Description=Local SSH SOCKS Proxy
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/ssh -p ${SSH_PORT} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i /root/.ssh/id_ed25519 -N -D 127.0.0.1:${SOCKS_PORT} 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload
  systemctl enable vaydns-iptables vaydns ssh-socks
  systemctl start vaydns-iptables vaydns ssh-socks

  echo
  echo -e "${GREEN}╔════════════════════════════════════════╗${NC}"
  echo -e "${GREEN}║     ✅ VAYDNS Installed Successfully   ║${NC}"
  echo -e "${GREEN}╚════════════════════════════════════════╝${NC}"
  echo
  echo -e "${CYAN}Domain:${NC} $DOMAIN"
  echo -e "${CYAN}SOCKS:${NC} socks5://127.0.0.1:${SOCKS_PORT}"
  echo -e "${CYAN}SSH Port:${NC} ${SSH_PORT}"
  echo
  echo -e "${YELLOW}🔗 DNS LINK:${NC}"
  generate_dns_link
}

############################################
# MAIN LOOP
############################################

while true; do
    show_menu
    case "$ACTION" in
      1) install_vaydns ;;
      2) remove_vaydns ;;
      3) show_dns_link ;;
      0) 
          echo -e "${GREEN}👋 Goodbye!${NC}"
          exit 0
          ;;
      *) 
          echo -e "${RED}❌ Invalid option${NC}"
          sleep 1
          ;;
    esac
done
